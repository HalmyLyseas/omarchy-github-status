    || not_ok "fold: My Issues filter chip does not toggle its section"
  [[ "$(field "$json" resetCollapsed)" == "true" && "$(field "$json" resetHidden)" == "true" ]] \
    && ok "fold: close/reopen restores all sections to folded" \
    || not_ok "fold: close/reopen restores all sections to folded"
fi
check_no_engine_errors "$log" "fold"
check_no_orphans "$mocklog" "fold"
check_exit_status "fold"

echo
echo "== (6) lifecycle: svc -> null -> new instance, zero TypeErrors (Panel null-guards every read) =="
log="$(run_scenario lifecycle lifecycle GH_MOCK_MODE=ok GHS_GHPATH="$MOCK_GH")"
json="$(json_line "$log")"
mocklog="$OUT_DIR/lifecycle.mock.log"
if [[ -z "$json" ]]; then
  not_ok "lifecycle: probe printed a PROBE_RESULT line"; cat "$log"
else
  ok "lifecycle: probe printed a PROBE_RESULT line"
  [[ "$(field "$json" svcWasNonNullBeforeDestroy)" == "true" ]] && ok "lifecycle: svc existed before the destroy" \
    || not_ok "lifecycle: svc existed before the destroy"
  [[ "$(field "$json" heroMetaWasLoadingWhileNull)" == "true" ]] && ok "lifecycle: heroMeta=\"Loading…\" while svc was null" \
    || not_ok "lifecycle: heroMeta=\"Loading…\" while svc was null (got: $(field "$json" heroMetaWasLoadingWhileNull))"
  [[ "$(field "$json" svcNowIsNewInstance)" == "true" ]] && ok "lifecycle: BarWidget/Panel picked up the fresh instance" \
    || not_ok "lifecycle: BarWidget/Panel picked up the fresh instance"
fi
check_no_engine_errors "$log" "lifecycle"
check_no_orphans "$mocklog" "lifecycle"
check_exit_status "lifecycle"

echo
echo "== (7) openItem: rejection stays open; safe argv launch closes popup =="
log="$(run_scenario openitem openitem GH_MOCK_MODE=ok GHS_GHPATH="$MOCK_GH")"
json="$(json_line "$log")"
mocklog="$OUT_DIR/openitem.mock.log"
if [[ -z "$json" ]]; then
  not_ok "openitem: probe printed a PROBE_RESULT line"; cat "$log"
else
  ok "openitem: probe printed a PROBE_RESULT line"
  [[ "$(field "$json" rejectedStayedOpen)" == "true" ]] && ok "openitem: rejected URL leaves popup open" \
    || not_ok "openitem: rejected URL leaves popup open"
  [[ "$(field "$json" closedAfterValid)" == "true" ]] && ok "openitem: safe handoff closes popup" \
    || not_ok "openitem: safe handoff closes popup"
  [[ "$(field "$json" xdgOpenCount)" == "1" ]] && ok "openitem: mock xdg-open records exactly one call" \
    || not_ok "openitem: mock xdg-open records exactly one call (got: $(field "$json" xdgOpenCount))"
