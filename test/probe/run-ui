  [[ "$(field "$json" status)" == "no-gh" ]] && ok "degraded-no-gh: status=no-gh" \
    || not_ok "degraded-no-gh: status=no-gh (got: $(field "$json" status))"
  [[ "$(field "$json" statusHintSevere)" == "true" ]] && ok "degraded-no-gh: statusHintSevere=true" \
    || not_ok "degraded-no-gh: statusHintSevere=true (got: $(field "$json" statusHintSevere))"
  [[ "$(field "$json" statusHint)" == *"GitHub CLI (gh) not found"* ]] && ok "degraded-no-gh: statusHint mentions gh not found" \
    || not_ok "degraded-no-gh: statusHint mentions gh not found (got: $(field "$json" statusHint))"
fi
check_no_engine_errors "$log" "degraded-no-gh"
check_no_orphans "$mocklog" "degraded-no-gh"
check_exit_status "degraded-no-gh"

echo
echo "== (2c) gh-unsupported: non-severe \"untested\" hint, auth/sync unaffected =="
log="$(run_scenario gh-unsupported degraded GH_MOCK_MODE=gh-unsupported GHS_GHPATH="$MOCK_GH")"
json="$(json_line "$log")"
mocklog="$OUT_DIR/gh-unsupported.mock.log"
if [[ -z "$json" ]]; then
  not_ok "gh-unsupported: probe printed a PROBE_RESULT line"; cat "$log"
else
  ok "gh-unsupported: probe printed a PROBE_RESULT line"
  [[ "$(field "$json" status)" == "ok" ]] && ok "gh-unsupported: status=ok (auth/sync unaffected)" \
    || not_ok "gh-unsupported: status=ok (got: $(field "$json" status))"
  [[ "$(field "$json" ghVersion)" == "3.0.0" ]] && ok "gh-unsupported: svc.ghVersion=3.0.0" \
    || not_ok "gh-unsupported: svc.ghVersion=3.0.0 (got: $(field "$json" ghVersion))"
  [[ "$(field "$json" ghVersionSupported)" == "false" ]] && ok "gh-unsupported: svc.ghVersionSupported=false" \
    || not_ok "gh-unsupported: svc.ghVersionSupported=false (got: $(field "$json" ghVersionSupported))"
  [[ "$(field "$json" statusHintSevere)" == "false" ]] && ok "gh-unsupported: statusHintSevere=false (not severe)" \
    || not_ok "gh-unsupported: statusHintSevere=false (got: $(field "$json" statusHintSevere))"
  [[ "$(field "$json" statusHint)" == *"GitHub CLI 3.0.0 is untested"* ]] && ok "gh-unsupported: statusHint mentions the untested version" \
    || not_ok "gh-unsupported: statusHint mentions the untested version (got: $(field "$json" statusHint))"
fi
check_no_engine_errors "$log" "gh-unsupported"
check_no_orphans "$mocklog" "gh-unsupported"
check_exit_status "gh-unsupported"

echo
echo "== (3) partial (C2 surface): hero meta gains \"· partial\", status hint gains its own line =="
log="$(run_scenario partial partial GH_MOCK_MODE=partial GHS_GHPATH="$MOCK_GH")"
json="$(json_line "$log")"
mocklog="$OUT_DIR/partial.mock.log"
if [[ -z "$json" ]]; then
  not_ok "partial: probe printed a PROBE_RESULT line"; cat "$log"
else
  ok "partial: probe printed a PROBE_RESULT line"
  [[ "$(field "$json" dashboardPartial)" == "true" ]] && ok "partial: svc.dashboardPartial=true" \
    || not_ok "partial: svc.dashboardPartial=true (got: $(field "$json" dashboardPartial))"
  [[ "$(field "$json" heroMeta)" == *"· partial"* ]] && ok "partial: heroMeta contains \"· partial\"" \
    || not_ok "partial: heroMeta contains \"· partial\" (got: $(field "$json" heroMeta))"
  [[ "$(field "$json" statusHint)" == "Some sections failed to load — showing last-known data for them." ]] \
    && ok "partial: statusHint reads the C2 surface message" \
    || not_ok "partial: statusHint reads the C2 surface message (got: $(field "$json" statusHint))"
fi
check_no_engine_errors "$log" "partial"
check_no_orphans "$mocklog" "partial"
check_exit_status "partial"

echo
echo "== (4) search: searchQuery narrows every filtered list, pill follows (no \"of T\" while searching) =="
log="$(run_scenario search search GH_MOCK_MODE=ok GHS_GHPATH="$MOCK_GH")"
json="$(json_line "$log")"
mocklog="$OUT_DIR/search.mock.log"
if [[ -z "$json" ]]; then
  not_ok "search: probe printed a PROBE_RESULT line"; cat "$log"
else
  ok "search: probe printed a PROBE_RESULT line"
  [[ "$(field "$json" beforeReposLength)" == "7" ]] && ok "search: before query, filteredRepos.length===7" \
    || not_ok "search: before query, filteredRepos.length===7 (got: $(field "$json" beforeReposLength))"
  [[ "$(field "$json" beforePill)" == "7 of 45" ]] && ok "search: before query, Repositories pill reads \"7 of 45\"" \
    || not_ok "search: before query, Repositories pill reads \"7 of 45\" (got: $(field "$json" beforePill))"
  [[ "$(field "$json" afterReposLength)" == "2" ]] && ok "search: \"vandal\" narrows filteredRepos to 2" \
    || not_ok "search: \"vandal\" narrows filteredRepos to 2 (got: $(field "$json" afterReposLength))"
  [[ "$(field "$json" afterIssuesLength)" == "1" ]] && ok "search: \"vandal\" narrows filteredMyIssues to 1" \
    || not_ok "search: \"vandal\" narrows filteredMyIssues to 1 (got: $(field "$json" afterIssuesLength))"
  [[ "$(field "$json" afterOpenPRsLength)" == "0" ]] && ok "search: \"vandal\" narrows filteredOpenPRs to 0" \
    || not_ok "search: \"vandal\" narrows filteredOpenPRs to 0 (got: $(field "$json" afterOpenPRsLength))"
  [[ "$(field "$json" afterPill)" == "2" ]] && ok "search: Repositories pill follows to \"2\", no \"of T\" while searching" \
    || not_ok "search: Repositories pill follows to \"2\" (got: $(field "$json" afterPill))"
fi
check_no_engine_errors "$log" "search"
check_no_orphans "$mocklog" "search"
check_exit_status "search"

echo
echo "== (5) fold: all sections start folded, remain foldable, and reset on reopen =="
log="$(run_scenario fold fold GH_MOCK_MODE=ok GHS_GHPATH="$MOCK_GH")"
json="$(json_line "$log")"
mocklog="$OUT_DIR/fold.mock.log"
if [[ -z "$json" ]]; then
  not_ok "fold: probe printed a PROBE_RESULT line"; cat "$log"
else
  ok "fold: probe printed a PROBE_RESULT line"
  [[ "$(field "$json" allFound)" == "true" ]] && ok "fold: found all five section row-list Columns" \
    || not_ok "fold: found all five section row-list Columns"
  [[ "$(field "$json" allInitiallyCollapsed)" == "true" ]] && ok "fold: all five backing states start collapsed" \
    || not_ok "fold: all five backing states start collapsed"
  [[ "$(field "$json" allInitiallyHidden)" == "true" ]] && ok "fold: all five row-list Columns start hidden" \
    || not_ok "fold: all five row-list Columns start hidden"
  [[ "$(field "$json" everyHeaderFoldable)" == "true" ]] && ok "fold: every header stays foldable, including empty/unsynced" \
