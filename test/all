#!/usr/bin/env bash
# test/all -- runs every test suite in this repo. Exits non-zero if any
# suite fails.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
overall=0

echo "== Model.js (node) =="
node "$SCRIPT_DIR/model.test.js"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
if [[ $overall -eq 0 ]]; then
  echo "test/all: ALL SUITES PASSED"
else
  echo "test/all: FAILURES ABOVE"
fi
exit $overall
