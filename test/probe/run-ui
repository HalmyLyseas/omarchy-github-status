    || not_ok "openitem: only the valid GitHub URL reaches fixed argv"
fi
check_no_engine_errors "$log" "openitem"
check_no_orphans "$mocklog" "openitem"
check_exit_status "openitem"

echo
if [[ "$fail_count" -eq 0 ]]; then
  echo "test/probe/run-ui: ALL CHECKS PASSED ($pass_count ok)"
else
  echo "test/probe/run-ui: $fail_count FAILURE(S), $pass_count ok"
fi
exit $(( fail_count > 0 ? 1 : 0 ))
