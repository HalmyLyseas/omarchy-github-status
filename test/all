#!/usr/bin/env bash
# test/all -- runs every test suite in this repo (Node unit tests, the QML
# Text-sink audit, both probe suites); exits non-zero if any suite fails.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
overall=0

echo "== Model.js (node) =="
node "$SCRIPT_DIR/model.test.js"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== qml-sinks.test.js (node) =="
node "$SCRIPT_DIR/qml-sinks.test.js"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== comment-hygiene.test.js (node) =="
node --test "$SCRIPT_DIR/comment-hygiene.test.js"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== test/probe/run (mock-gh service probe suite) =="
bash "$SCRIPT_DIR/probe/run"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== test/probe/run-ui (UI probe suite) =="
bash "$SCRIPT_DIR/probe/run-ui"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
if [[ $overall -eq 0 ]]; then
  echo "test/all: ALL SUITES PASSED"
else
  echo "test/all: FAILURES ABOVE"
fi
exit $overall
