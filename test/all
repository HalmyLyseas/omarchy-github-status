#!/usr/bin/env bash
# test/all -- runs every test suite in this repo: Node unit tests over
# Model.js, the QML Text-sink audit, test/probe/run (the mock-gh service
# probe suite driving the real Service.qml), then test/probe/run-ui (the
# UI probe driving the real BarWidget/Panel). Exits non-zero if any suite
# fails.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
overall=0

echo "== Model.js (node) =="
node "$SCRIPT_DIR/model.test.js"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== qml-sinks.test.js (node) =="
node "$SCRIPT_DIR/qml-sinks.test.js"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== test/probe/run (mock-gh service probe suite) =="
bash "$SCRIPT_DIR/probe/run"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== test/probe/run-ui (UI probe suite) =="
bash "$SCRIPT_DIR/probe/run-ui"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
if [[ $overall -eq 0 ]]; then
  echo "test/all: ALL SUITES PASSED"
else
  echo "test/all: FAILURES ABOVE"
fi
exit $overall
