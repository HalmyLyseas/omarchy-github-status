#!/usr/bin/env bash
# scripts/fetch-dashboard -- one read-only GraphQL call that covers the
# viewer's own open PRs (title/CI rollup/review decision), PRs waiting on
# the viewer's review, and per-repo activity (latest commit, open issue/PR
# counts, latest release) for every owned repo.
#
# GET-equivalent only: this is a GraphQL `query`, never a `mutation` -- see
# CLAUDE.md hard rule #2 (the plugin never mutates GitHub state).
#
# The query text below was extended live 2026-08-27 for
# exchange/19-feedback-delta-spec.md (F1/F2/F3): `stargazerCount` added to
# `repositories.nodes` (F1/F2 -- repo sort by stars, repo status pills);
# `myIssues` added as a viewer-scoped alias of `issues(states: OPEN, ...)`
# (F3 -- issues the account itself opened, any repo). `myIssues`'s semantics
# were live-verified against this account, not assumed: `viewer.issues`
# (no `filterBy`) returned exactly this account's own authored open issues
# across five different repos it does not all own -- including
# `HANCORE-linux/omarchy-plugin-marketplace#2672`, the acceptance fixture --
# every node's `author.login` matched `viewer.login` in that live probe (see
# exchange/20-s8-data-delta.md for the trimmed evidence). Same shape/first:
# window discipline as `openPRs` above: capped at `first: 20`,
# `orderBy: UPDATED_AT DESC`, the exact same pattern already used for
# `openPRs` (an authored, viewer-scoped connection).
#
# Extended live again 2026-08-28 for exchange/26-feedback2-delta-spec.md
# (G2/G4): `comments(last: 1) { nodes { author { login } updatedAt } }` added
# to `openPRs.nodes`, `myIssues.nodes`, and the `reviewRequests` search PR
# fragment (G2 -- last-commenter tooltip; the single most recent comment
# only, never a full comment list); `viewerSubscription` added to
# `myIssues.nodes` only (G4 -- Focus/All toggle; live-verified against this
# account: `ValveSoftware/Proton#8626` -> `UNSUBSCRIBED`,
# `HANCORE-linux/omarchy-plugin-marketplace#2672` -> `SUBSCRIBED`, see
# exchange/27-s13-data-delta.md for the trimmed evidence). Wall time and
# graphql point cost are unchanged by this addition (~2s, ~1 point) --
# `comments(last: 1)` and `viewerSubscription` are both cheap fields on an
# already-fetched node, not a new connection root.
#
# The remainder of the query is byte-identical to the version originally
# verified live in exchange/04-github-data.md #6. Do not edit the query
# without re-verifying against a real `gh api graphql` call and updating
# that doc.
#
# NOTE (deviation from exchange/06-design.md's literal suggestion of
# `-f query=@-`): `gh api`'s `@<path>`/`@-` file/stdin-reading syntax is only
# documented and only actually works for the typed `-F/--field` flag, not
# `-f/--raw-field` -- verified live 2026-08-27, `-f query=@-` sends the
# literal 2-byte string "@-" as the query and GraphQL rejects it
# ("Expected one of SCHEMA, ... actual: DIR_SIGN (\"@\")"). `-F query=@-`
# works correctly. See exchange/07-s1-scaffold.md.
#
# Invocation: no arguments. Runs via `bash -lc` from QML (see
# exchange/03-shell-api.md #12 trap 11) so PATH is resolved the same way the
# compositor session's login shell resolves it -- `gh` may live under a
# user-managed tool-version-manager path (e.g. mise) that isn't on a bare
# Quickshell-spawned process's PATH.
#
# stdout: raw `gh` JSON response (the whole GraphQL envelope, including a
# top-level "errors" key on partial failure -- callers must check for that).
# stderr: passthrough from `gh`. Exit code: gh's exit code, unchanged.
set -euo pipefail

exec gh api graphql -F query=@- <<'GRAPHQL'
query {
  viewer {
    login
    openPRs: pullRequests(states: OPEN, first: 20, orderBy: {field: UPDATED_AT, direction: DESC}) {
      totalCount
      nodes {
        title url number updatedAt isDraft reviewDecision
        repository { nameWithOwner }
        commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
        comments(last: 1) { nodes { author { login } updatedAt } }
      }
    }
    myIssues: issues(states: OPEN, first: 20, orderBy: {field: UPDATED_AT, direction: DESC}) {
      totalCount
      nodes {
        title url number updatedAt viewerSubscription
        repository { nameWithOwner }
        comments(last: 1) { nodes { author { login } updatedAt } }
      }
    }
    repositories(first: 20, ownerAffiliations: OWNER, orderBy: {field: PUSHED_AT, direction: DESC}) {
      totalCount
      nodes {
        name pushedAt isPrivate isArchived isFork stargazerCount
        openIssues: issues(states: OPEN) { totalCount }
        openPRCount: pullRequests(states: OPEN) { totalCount }
        latestRelease { tagName name publishedAt url }
        defaultBranchRef {
          target {
            ... on Commit { oid messageHeadline committedDate statusCheckRollup { state } }
          }
        }
      }
    }
  }
  reviewRequests: search(query: "is:open is:pr review-requested:@me", type: ISSUE, first: 10) {
    nodes {
      ... on PullRequest {
        title url number updatedAt
        repository { nameWithOwner }
        comments(last: 1) { nodes { author { login } updatedAt } }
      }
    }
  }
}
GRAPHQL
